<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17">
    <ListView fx:id="personListView" VBox.vgrow="ALWAYS">
        <placeholder>
            <Label text="No contacts to show. Use list to see all contacts." styleClass="empty-list-label"
                   wrapText="true"/>
        </placeholder>
    </ListView>
</VBox>
