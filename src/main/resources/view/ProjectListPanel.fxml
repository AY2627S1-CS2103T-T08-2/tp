<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17">
    <ListView fx:id="projectListView" VBox.vgrow="ALWAYS">
        <placeholder>
            <Label text="No projects to show. Use listprojects to see all projects, or addproject to create one."
                   styleClass="empty-list-label" wrapText="true"/>
        </placeholder>
    </ListView>
</VBox>
