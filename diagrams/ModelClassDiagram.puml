@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR

Package Model as ModelPackage <<Rectangle>>{
Class "<<interface>>\nReadOnlyAddressBook" as ReadOnlyAddressBook
Class "<<interface>>\nReadOnlyUserPrefs" as ReadOnlyUserPrefs
Class "<<interface>>\nModel" as Model
Class AddressBook
Class ModelManager
Class UserPrefs

Class UniquePersonList
Class Person
Class PersonId
Class Address
Class Email
Class Name
Class Phone
Class Tag

Class UniqueProjectList
Class Project
Class ProjectId
Class ProjectName
Class Deadline
Class Description

Class UniqueProjectMembershipList
Class ProjectMembership

Class I #FFFFFF
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Model

AddressBook .up.|> ReadOnlyAddressBook

ModelManager .up.|> Model
Model .right.> ReadOnlyUserPrefs
Model .left.> ReadOnlyAddressBook
ModelManager -left-> "1" AddressBook
ModelManager -right-> "1" UserPrefs
UserPrefs .up.|> ReadOnlyUserPrefs

AddressBook *--> "1" UniquePersonList
UniquePersonList --> "~* all" Person
Person *--> "1" PersonId
Person *--> Name
Person *--> Phone
Person *--> Email
Person *--> Address
Person *--> "*" Tag

AddressBook *--> "1" UniqueProjectList
UniqueProjectList --> "~* all" Project
Project *--> "1" ProjectId
Project *--> ProjectName
Project *--> Deadline
Project *--> Description

AddressBook *--> "1" UniqueProjectMembershipList
UniqueProjectMembershipList --> "~* all" ProjectMembership
ProjectMembership --> "1" PersonId
ProjectMembership --> "1" ProjectId

Person -[hidden]up--> I
UniquePersonList -[hidden]right-> I

PersonId -[hidden]right-> Name
Name -[hidden]right-> Phone
Phone -[hidden]right-> Address
Address -[hidden]right-> Email

UniquePersonList -[hidden]down-> UniqueProjectList
UniqueProjectList -[hidden]down-> UniqueProjectMembershipList

ProjectId -[hidden]right-> ProjectName
ProjectName -[hidden]right-> Deadline
Deadline -[hidden]right-> Description

ModelManager --> "~* filtered" Person
@enduml
